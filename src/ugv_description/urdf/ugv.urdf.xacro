<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="ugv">

  <!-- ==================== -->
  <!-- Materials            -->
  <!-- ==================== -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>


  <!-- ==================== -->
  <!-- Chassis               -->
  <!-- ==================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>

      <geometry>
        <box size="1.2 0.8 0.3"/>
      </geometry>

      <material name="blue"/>
    </visual>

  </link>


  <!-- ==================== -->
  <!-- Wheel macro           -->
  <!-- ==================== -->

  <xacro:macro name="wheel" params="name x y">

    <link name="${name}">

      <visual>

        <origin xyz="0 0 0" rpy="1.5708 0 0"/>

        <geometry>
          <cylinder radius="0.18" length="0.12"/>
        </geometry>

        <material name="black"/>

      </visual>

    </link>


    <joint name="${name}_joint"
           type="continuous">

      <parent link="base_link"/>
      <child link="${name}"/>

      <origin xyz="${x} ${y} 0.0"
              rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>


  <!-- ==================== -->
  <!-- Four wheels          -->
  <!-- ==================== -->

  <xacro:wheel
      name="front_left_wheel"
      x="0.4"
      y="0.46"/>

  <xacro:wheel
      name="front_right_wheel"
      x="0.4"
      y="-0.46"/>

  <xacro:wheel
      name="rear_left_wheel"
      x="-0.4"
      y="0.46"/>

  <xacro:wheel
      name="rear_right_wheel"
      x="-0.4"
      y="-0.46"/>

</robot>
