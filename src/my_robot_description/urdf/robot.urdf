<?xml version="1.0"?>

<robot name="my_robot">

  <link name="base_link">

    <visual>
      <geometry>
        <box size="1 1 1"/>
      </geometry>
    </visual>

  </link>


  <link name="link2">

    <visual>
      <geometry>
        <box size="0.5 0.5 0.5"/>
      </geometry>
    </visual>

  </link>


  <joint name="joint1" type="fixed">

  <parent link="base_link"/>
  <child link="link2"/>

  <origin xyz="0 0 0.75" rpy="0 0 0"/>

</joint>

</robot>
